; Look Busy - a PS1-style 3D office where every desk runs a real game.
; Scaling rule: 720x1280 base, canvas_items + expand. Phones lock to portrait,
; desktop (Steam) opens a 1280x720 window, and the UI switches layout by screen shape.
; The mini games live in addons/hh_minigames (this repo is their source of truth).
; Input map: keyboard + Xbox pad. The office and the games read pad events
; directly (so a pad never leaks between desks); these actions name the same
; bindings for remapping and for new code.

config_version=5

[application]

config/name="Look Busy"
run/main_scene="res://scenes/office/office.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[audio]

driver/enable_input=true
general/text_to_speech=true

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override.pc=1280
window/size/window_height_override.pc=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

